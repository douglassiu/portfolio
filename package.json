{
  "name": "portfolio",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install-all": "npm install --workspaces",
    "dev": "concurrently \"npm --workspace client run dev\" \"npm --workspace server run dev\"",
    "start": "npm --workspace server run start",
    "build": "npm --workspace client run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
